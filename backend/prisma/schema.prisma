generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Módulo de animales

enum Especie {
  PERRO
  GATO
  OTRO
}

enum SexoAnimal {
  MACHO
  HEMBRA
  DESCONOCIDO
}

enum EstadoEstadiaAnimal {
  ACTIVO
  ADOPTADO
  ESPERA_ADOPCION
  EGRESADO
  FALLECIDO
  TRANSFERIDO
}

model FichaAnimal {
  id             Int                 @id @default(autoincrement())
  codigoAnimal   String              @unique
  nombre         String?
  sexoAnimal     SexoAnimal
  especie        Especie
  raza           String?
  edad           Int?
  estadoEstadia  EstadoEstadiaAnimal @default(ACTIVO)
  estadoAdopcion EstadoAdopcion?
  observaciones  String?
  createdAt      DateTime            @default(now())

  ingresoAnimal         IngresoAnimal[]
  postulacionesAdopcion Postulacion[]
  devoluciones          Devolucion[]
  atencionesSanitarias  AtencionSanitaria[]

  registroMedicoAnimal  RegistroMedicoAnimal?
  actualizacionesEstado ActualizacionEstadoAnimal[]
}

model IngresoAnimal {
  id                  Int         @id @default(autoincrement())
  fichaAnimalId       Int
  fichaAnimal         FichaAnimal @relation(fields: [fichaAnimalId], references: [id])
  receptorId          Int
  receptor            Voluntario  @relation(fields: [receptorId], references: [id])
  fechaIngreso        DateTime
  procedencia         String
  ubicacionEncontrado String?
  estadoSalud         String?

  registroMedicoAnimal RegistroMedicoAnimal?
}

model Voluntario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  ingresosRecibidos      IngresoAnimal[]
  postulacionesRevisadas Postulacion[]
  devolucionesRecibidas  Devolucion[]
  reportesGenerados      ReporteDevolucion[]
  usuario                Usuario?
}

// Módulo de adopción

enum EstadoPostulacion {
  EN_REVISION
  APROBADA
  RECHAZADA
  CERRADA
  ENTREGADA
}

enum TipoVivienda {
  CASA
  DEPARTAMENTO
  OTRO
}

model Postulacion {
  id                   Int               @id @default(autoincrement())
  fichaAnimalId        Int
  fichaAnimal          FichaAnimal       @relation(fields: [fichaAnimalId], references: [id])
  nombrePostulante     String
  rutPostulante        String
  telefonoPostulante   String
  emailPostulante      String?
  revisorId            Int?
  revisor              Voluntario?       @relation(fields: [revisorId], references: [id])
  tipoVivienda         TipoVivienda
  otrasMascotas        String?
  alertaMostradaEn     DateTime?
  disponibilidadTiempo String
  fechaResolucion      DateTime?
  observaciones        String?
  estado               EstadoPostulacion @default(EN_REVISION)
  createdAt            DateTime          @default(now())

  devoluciones Devolucion[]

  @@index([fichaAnimalId])
  @@index([estado])
  @@index([rutPostulante])
}

// Módulo de devoluciones

enum MotivoDevolucion {
  COMPORTAMIENTO
  SALUD
  CAMBIO_SITUACION_FAMILIAR
  OTRO
}

model Devolucion {
  id              Int              @id @default(autoincrement())
  fichaAnimalId   Int
  fichaAnimal     FichaAnimal      @relation(fields: [fichaAnimalId], references: [id])
  receptorId      Int
  receptor        Voluntario       @relation(fields: [receptorId], references: [id])
  postulacionId   Int
  postulacion     Postulacion      @relation(fields: [postulacionId], references: [id])
  fechaDevolucion DateTime
  motivo          MotivoDevolucion
  detalle         String
  createdAt       DateTime         @default(now())
}

model ReporteDevolucion {
  id                Int        @id @default(autoincrement())
  fechaDesde        DateTime
  fechaHasta        DateTime
  totalDevoluciones Int
  resultado         Json
  generadoPorId     Int
  generadoPor       Voluntario @relation(fields: [generadoPorId], references: [id])
  createdAt         DateTime   @default(now())
}

// Módulo sanitario

enum TipoAtencionSanitaria {
  vacuna
  tratamiento
  control
  desparasitacion
  esterilizacion
}

enum EstadoAtencionSanitaria {
  PENDIENTE
  REALIZADA
  CANCELADA
}

model AtencionSanitaria {
  id                Int                     @id @default(autoincrement())
  fichaAnimalId     Int
  fichaAnimal       FichaAnimal             @relation(fields: [fichaAnimalId], references: [id], onDelete: Restrict)
  registroMedicoId  Int?
  registroMedico    RegistroMedicoAnimal?   @relation(fields: [registroMedicoId], references: [id], onDelete: SetNull)
  tipo              TipoAtencionSanitaria
  fechaProgramada   DateTime                @db.Date
  estado            EstadoAtencionSanitaria @default(PENDIENTE)
  fechaRealizacion  DateTime?               @db.Date
  motivoCancelacion String?
  observaciones     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([estado, fechaProgramada])
  @@index([fichaAnimalId, fechaProgramada])
  @@index([registroMedicoId])
}

// Cuentas y roles

enum RolUsuario {
  DIRECTORA
  ENCARGADA_VOLUNTARIADO
  ENCARGADA_ADOPCIONES
  VETERINARIA
  VOLUNTARIO
}

model Usuario {
  id           Int        @id @default(autoincrement())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)
  tokenVersion Int        @default(0)

  voluntarioId Int?        @unique
  voluntario   Voluntario? @relation(fields: [voluntarioId], references: [id], onDelete: Restrict)

  revisionesInicialesCreadas      RevisionInicial[]           @relation("RevisionInicialCreatedBy")
  revisionesInicialesActualizadas RevisionInicial[]           @relation("RevisionInicialUpdatedBy")
  revisionesCompletasCreadas      RevisionCompleta[]          @relation("RevisionCompletaCreatedBy")
  revisionesCompletasActualizadas RevisionCompleta[]          @relation("RevisionCompletaUpdatedBy")
  tratamientosCreados             TratamientoAnimal[]
  enfermedadesCreadas             EnfermedadAnimal[]
  seguimientosCreados             SeguimientoMedicoAnimal[]
  atencionesRegistradas           AtencionVeterinaria[]
  actualizacionesEstadoAnimal     ActualizacionEstadoAnimal[]
  auditoriasRealizadas            AuditoriaRevisionInicial[]
  versionesHistorial              HistorialRegistroMedico[]
  notificacionesRecibidas         Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Módulo de registro médico 

enum EstadoValidacionMedica {
  PROVISIONAL
  VALIDACION_PENDIENTE
  REVISANDO
  ACTUALIZADO
  REALIZADO
}

enum ClasificacionSalud {
  NORMAL
  ENFERMO
  CRITICO
}

enum EstadoRevisionInicial {
  PENDIENTE
  COMPLETADA
  ACTUALIZADA
  BLOQUEADA
}

enum EstadoEnfermedad {
  EN_CURSO
  RESUELTO
  CRONICO
}

enum EvolucionEstadoSalud {
  MEJORANDO
  EMPEORANDO
  ESTABLE
}

enum EstadoTratamiento {
  EN_CURSO
  RESUELTO
  CRONICO
}

enum EstadoAdopcion {
  ADOPTABLE
  NO_ADOPTABLE
}

model RegistroMedicoAnimal {
  id              Int            @id @default(autoincrement())
  animalId        Int            @unique
  animal          FichaAnimal    @relation(fields: [animalId], references: [id], onDelete: Restrict)
  ingresoAnimalId Int?           @unique
  ingresoAnimal   IngresoAnimal? @relation(fields: [ingresoAnimalId], references: [id], onDelete: Restrict)

  estadoValidacion EstadoValidacionMedica @default(PROVISIONAL)
  createdAt        DateTime               @default(now())

  revisionInicial        RevisionInicial?
  revisionCompleta       RevisionCompleta?
  tratamientos           TratamientoAnimal[]
  enfermedades           EnfermedadAnimal[]
  seguimientos           SeguimientoMedicoAnimal[]
  atencionesVeterinarias AtencionVeterinaria[]
  atencionesSanitarias   AtencionSanitaria[]
  auditorias             AuditoriaRevisionInicial[]
  historial              HistorialRegistroMedico[]
  notificaciones         Notificacion[]

  @@index([estadoValidacion])
}

model RevisionInicial {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int                  @unique
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  clasificacionSalud     ClasificacionSalud?
  prioridadAtencion      Int?
  cuarentena             Boolean?
  observacionEstadoSalud String?
  estadoRevisionInicial  EstadoRevisionInicial @default(PENDIENTE)

  createdAt   DateTime  @default(now())
  createdById Int
  createdBy   Usuario   @relation("RevisionInicialCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   Usuario?  @relation("RevisionInicialUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime? @updatedAt

  @@index([estadoRevisionInicial])
}

model RevisionCompleta {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int                  @unique
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  edad                          Int?
  peso                          Decimal?            @db.Decimal(5, 2)
  descripcionCuidadosEspeciales String?
  descripcionCondicionMedica    String?
  estadoSalud                   ClasificacionSalud?

  createdAt   DateTime  @default(now())
  createdById Int
  createdBy   Usuario   @relation("RevisionCompletaCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   Usuario?  @relation("RevisionCompletaUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime? @updatedAt
}

model TratamientoAnimal {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  descripcionTratamiento String
  fechaInicio            DateTime
  fechaFin               DateTime?
  observaciones          String?

  createdAt   DateTime @default(now())
  createdById Int
  createdBy   Usuario  @relation(fields: [createdById], references: [id])

  seguimientos SeguimientoTratamientoAnimal[]

  @@index([registroMedicoId])
}

model EnfermedadAnimal {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  descripcionEnfermedad String
  tipoEnfermedad        String?

  createdAt   DateTime @default(now())
  createdById Int
  createdBy   Usuario  @relation(fields: [createdById], references: [id])

  seguimientos SeguimientoEnfermedadAnimal[]

  @@index([registroMedicoId])
}

model AtencionVeterinaria {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  lugarAtencion        String?
  nombreClinicaExterna String?
  nombreMedico         String? //quien atiende
  fechaAtencion        DateTime
  descripcionAtencion  String?
  resultado            String?

  createdAt   DateTime @default(now())
  createdById Int
  createdBy   Usuario  @relation(fields: [createdById], references: [id])

  @@index([registroMedicoId])
}

model SeguimientoMedicoAnimal {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  fechaRegistro          DateTime
  peso                   Decimal?             @db.Decimal(5, 2)
  observacionSeguimiento String
  estadoSalud            ClasificacionSalud
  evolucionEstadoSalud   EvolucionEstadoSalud

  createdAt   DateTime @default(now())
  createdById Int
  createdBy   Usuario  @relation(fields: [createdById], references: [id])

  seguimientosEnfermedad  SeguimientoEnfermedadAnimal[]
  seguimientosTratamiento SeguimientoTratamientoAnimal[]

  @@index([registroMedicoId, fechaRegistro])
}

model SeguimientoEnfermedadAnimal {
  id                  Int                     @id @default(autoincrement())
  seguimientoMedicoId Int
  seguimientoMedico   SeguimientoMedicoAnimal @relation(fields: [seguimientoMedicoId], references: [id], onDelete: Cascade)
  enfermedadId        Int
  enfermedad          EnfermedadAnimal        @relation(fields: [enfermedadId], references: [id], onDelete: Restrict)

  estadoEnfermedad       EstadoEnfermedad
  observacionSeguimiento String?

  @@index([seguimientoMedicoId])
  @@index([enfermedadId])
}

model SeguimientoTratamientoAnimal {
  id                  Int                     @id @default(autoincrement())
  seguimientoMedicoId Int
  seguimientoMedico   SeguimientoMedicoAnimal @relation(fields: [seguimientoMedicoId], references: [id], onDelete: Cascade)
  tratamientoId       Int
  tratamiento         TratamientoAnimal       @relation(fields: [tratamientoId], references: [id], onDelete: Restrict)

  estadoTratamiento      EstadoTratamiento
  observacionSeguimiento String?

  @@index([seguimientoMedicoId])
  @@index([tratamientoId])
}

model ActualizacionEstadoAnimal {
  id       Int         @id @default(autoincrement())
  animalId Int
  animal   FichaAnimal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  estadoAnterior     EstadoAdopcion?
  estadoNuevo        EstadoAdopcion
  fechaActualizacion DateTime        @default(now())

  updatedById Int
  updatedBy   Usuario @relation(fields: [updatedById], references: [id])

  @@index([animalId, fechaActualizacion])
}

model AuditoriaRevisionInicial {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  campo         String
  valorAnterior String?
  valorNuevo    String?
  hora          String

  fecha   DateTime @default(now())
  autorId Int
  autor   Usuario  @relation(fields: [autorId], references: [id])

  @@index([registroMedicoId])
}

model HistorialRegistroMedico {
  id               Int                  @id @default(autoincrement())
  registroMedicoId Int
  registroMedico   RegistroMedicoAnimal @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)

  version                       Int
  estadoOrigen                  EstadoValidacionMedica
  peso                          Decimal?               @db.Decimal(5, 2)
  clasificacionSalud            ClasificacionSalud?
  descripcionCuidadosEspeciales String?
  descripcionCondicionMedica    String?
  descripcionTratamientos       String?
  descripcionEnfermedades       String?

  fecha            DateTime @default(now())
  actualizadoPorId Int
  actualizadoPor   Usuario  @relation(fields: [actualizadoPorId], references: [id])

  @@unique([registroMedicoId, version])
  @@index([registroMedicoId, version])
}

model Notificacion {
  id               Int                   @id @default(autoincrement())
  destinatarioId   Int
  destinatario     Usuario               @relation(fields: [destinatarioId], references: [id])
  tipo             String
  titulo           String
  mensaje          String
  registroMedicoId Int?
  registroMedico   RegistroMedicoAnimal? @relation(fields: [registroMedicoId], references: [id], onDelete: Cascade)
  leida            Boolean               @default(false)
  createdAt        DateTime              @default(now())

  @@index([destinatarioId, leida])
}
